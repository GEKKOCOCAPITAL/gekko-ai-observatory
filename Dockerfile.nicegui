# NiceGUI dashboard container (used for Hugging Face Spaces; also runs locally:
#   docker build -f Dockerfile.nicegui -t gekko-nicegui . && docker run -p 7860:7860 gekko-nicegui)
FROM python:3.12-slim
RUN useradd -m -u 1000 user
USER user
ENV HOME=/home/user PATH=/home/user/.local/bin:$PATH PORT=7860 HOST=0.0.0.0
WORKDIR /home/user/app
COPY --chown=user requirements-nicegui.txt .
RUN pip install --no-cache-dir --user -r requirements-nicegui.txt
COPY --chown=user . .
EXPOSE 7860
CMD ["python", "app/nicegui_app.py"]
